import QtQuick
import QtQuick.Layouts
import org.kde.plasma.plasmoid
import org.kde.plasma.core as PlasmaCore
import org.kde.plasma.plasma5support as P5Support
import org.kde.plasma.private.kicker as Kicker
import org.kde.kirigami as Kirigami

PlasmoidItem {
    id: root

    Plasmoid.icon: Plasmoid.configuration.icon

    toolTipMainText: i18n("plasma-eleven-menu")
    toolTipSubText: i18n("Launch applications")

    hideOnWindowDeactivate: true

    // Full-screen mode: a Plasma dialog covering the whole screen (below the panels).
    readonly property bool fullscreenMode:
        Plasmoid.configuration.fullscreen === true

    // Interface size from the settings (the base is the icon size; 32 px =
    // 100%): uiScale scales icons, fonts, grid cells, category tiles
    // and footer elements throughout the menu.
    readonly property int appIconSize:
        Math.max(16, Math.min(128, Plasmoid.configuration.iconSize))
    readonly property real uiScale:
        appIconSize / Kirigami.Units.iconSizes.medium
    // Fonts scale MORE GENTLY than the rest of the interface (halfway
    // towards the full scale): at a 200% interface, text is at 150%.
    readonly property real fontScale: 1 + (uiScale - 1) / 2

    // Keyboard navigation mode: arrows/Enter in the views enable it,
    // mouse movement over the menu disables it. While active, the hover
    // highlight under the cursor goes out, and the item selected with the
    // arrow keys is highlighted IDENTICALLY to hover (one highlight at a time).
    property bool keyboardNav: false

    // The pattern used by Application Dashboard (kickerdash, verified
    // in the Plasma 6.7.5 sources): the panel ICON is the fullRepresentation
    // rendered inline (preferred == full; without switchWidth/Height the
    // applet never enters the collapsed state), so the built-in
    // popup/expander physically cannot appear and duplicates nothing. Both
    // menu views — popup and full screen — are dialogs of their own, driven
    // solely by toggle() (icon click and Plasmoid.onActivated, i.e. Super).
    preferredRepresentation: fullRepresentation

    // "activated" (Super / launcher shortcut) must not touch "expanded".
    activationTogglesExpanded: false

    // The currently selected menu view.
    readonly property var activeDialog:
        fullscreenMode ? fullscreenDialog : popupDialog

    // The panel-free area, NORMALIZED to the screen's local coordinates
    // (0,0 = top-left corner of the applet's screen). availableScreenRect
    // is sometimes reported locally (on monitors offset in the global
    // layout) and sometimes globally — we reduce both variants to one.
    // An empty rectangle => the whole screen. Shared by both dialogs.
    readonly property rect localFreeArea: {
        const sg = root.screenGeometry
        const ar = root.availableScreenRect
        if (!ar || ar.width <= 0 || ar.height <= 0) {
            return Qt.rect(0, 0, sg.width, sg.height)
        }
        if (ar.x >= sg.x && ar.y >= sg.y
                && ar.x + ar.width <= sg.x + sg.width + 1
                && ar.y + ar.height <= sg.y + sg.height + 1) {
            return Qt.rect(ar.x - sg.x, ar.y - sg.y, ar.width, ar.height)
        }
        return Qt.rect(
            Math.max(0, ar.x),
            Math.max(0, ar.y),
            Math.min(ar.width, sg.width),
            Math.min(ar.height, sg.height))
    }

    // The Super key / the applet's global shortcut.
    Connections {
        target: Plasmoid
        function onActivated() {
            root.activeDialog.toggle()
        }
    }

    // Auto-hiding panels slide out while the menu is open.
    // Deliberately NeedsAttentionStatus, NOT AcceptingInputStatus: the
    // latter makes the panel take keyboard focus and force activation of
    // the panel's first element (PanelView::refreshStatus), so hovering
    // over another applet while the menu was opening activated that applet
    // instead of the menu. NeedsAttention only shows the panel (no focus),
    // and PanelView::restoreAutoHide keeps it out as long as status >= NeedsAttention.
    Plasmoid.status: fullscreenDialog.visible || popupDialog.visible
        ? PlasmaCore.Types.NeedsAttentionStatus
        : PlasmaCore.Types.ActiveStatus

    function closeMenu() {
        popupDialog.closeMenu()
        fullscreenDialog.closeMenu()
    }

    // --- Suspending panel hiding while the full-screen menu is open ---
    // The applet status keeps only the host panel visible; the screen's
    // remaining panels (auto-hide / window-dodging) are switched via the
    // plasmashell scripting interface to "windowsgobelow" (visible above
    // windows, without reserving space) and restored on close.
    //
    // THE BACKUP OF THE MODES LIVES IN A FILE ON DISK (not in the applet
    // configuration!): ~/.config/plasma-eleven-menu/panel-backup.json.
    // The applet configuration is unusable as a carrier because
    // plasmashell flushes it to disk lazily — when shutting the system
    // down with the menu open, the panel modes managed to get persisted
    // while the backup did not, and the panels were left in
    // "windowsgobelow" with no trace of the original. The file is written
    // SYNCHRONOUSLY (sync + atomic mv) BEFORE the panels are mutated, is
    // created only when there actually is something to suspend, is loaded
    // with retries at plasmashell start (= applet start), and after EVERY
    // confirmed restore — deleted. So the file's mere existence means:
    // "the panels have been changed and are waiting to be restored".

    // Game Mode (Bazzite): available only when an executable
    // /usr/bin/return-to-gamemode exists at applet start.
    property bool gameModeAvailable: false

    function runGameMode() {
        closeMenu()
        shellExec.connectSource("/usr/bin/return-to-gamemode")
    }

    // Panel-suspension state machine: idle -> reading -> persisting ->
    // applying -> active -> (restore) -> idle. INVARIANT: no panel goes
    // into windowsgobelow before its original mode sits IN THE FILE ON
    // DISK, and the file disappears only after a CONFIRMED restore.
    property string panelSuspendState: "idle"
    property int panelOpSeq: 0

    // In-memory copy of the modes for the current session (a mirror of the
    // file contents). Entry: "panelId;screen;location;modeInt" (mode:
    // 1=autohide, 2=dodgewindows — VisibilityMode enum values from panelview.h).
    property var panelBackup: []

    // Two applet instances (one per monitor) run in the same plasmashell
    // process — each has ITS OWN backup file and its own command tags, so
    // they do not wipe each other out and so the "executable" engine
    // (which deduplicates identical commands) does not merge them.
    readonly property string instanceTag: String(Plasmoid.id)

    function opTag(name) {
        return " #" + name + "@" + instanceTag + ":" + (++panelOpSeq)
    }

    // Backup file paths, in a form ready to be pasted into a shell
    // command (expanded by sh only at execution time).
    readonly property string backupDirSh:
        '"${XDG_CONFIG_HOME:-$HOME/.config}/plasma-eleven-menu"'
    readonly property string backupFileSh:
        backupDirSh.slice(0, -1) + '/panel-backup-' + instanceTag + '.json"'
    // Shared file of the older applet version — read and cleaned up
    // for migration at start.
    readonly property string legacyBackupFileSh:
        backupDirSh.slice(0, -1) + '/panel-backup.json"'

    P5Support.DataSource {
        id: shellExec
        engine: "executable"
        connectedSources: []
        onNewData: (sourceName, data) => {
            const ok = (data["exit code"] ?? -1) === 0
            if (sourceName.indexOf("#gamemodecheck") !== -1) {
                root.gameModeAvailable =
                    ok && (data.stdout ?? "").indexOf("GMYES") !== -1
            } else if (sourceName.indexOf("#suspendread") !== -1) {
                root.onSuspendRead(ok, data.stdout ?? "")
            } else if (sourceName.indexOf("#persist") !== -1) {
                root.onPersistDone(ok)
            } else if (sourceName.indexOf("#apply") !== -1) {
                root.onApplyDone(ok)
            } else if (sourceName.indexOf("#restore") !== -1) {
                root.onRestoreDone(ok, data.stdout ?? "")
            } else if (sourceName.indexOf("#bootread") !== -1) {
                root.onBootRead(ok, data.stdout ?? "")
            }
            disconnectSource(sourceName)
        }
    }

    function shellScriptCommand(js) {
        return 'gdbus call --session --dest org.kde.plasmashell'
            + ' --object-path /PlasmaShell'
            + ' --method org.kde.PlasmaShell.evaluateScript "'
            + js.replace(/"/g, '\\"') + '"'
    }

    // PHASE 1: READ-ONLY query of this screen's panel modes — no mutation.
    function suspendPanelHiding() {
        if (panelSuspendState !== "idle") {
            return
        }
        if (panelBackup.length > 0) {
            // A leftover backup from a previous cycle — restore will handle it.
            return
        }
        panelSuspendState = "reading"
        // The mode is stored as an INT (1=autohide, 2=dodgewindows) and a
        // panel is identified by p.id — the same number as in the
        // [PlasmaViews][Panel <id>] group in plasmashellrc, so the backup
        // later allows reading and writing the mode DIRECTLY on disk.
        // Note: a panel already in windowsgobelow is not caught by this
        // filter also because the p.hiding getter in Plasma 6.7.5 returns
        // "none" for it (no case in Panel::hiding()).
        const sg = root.screenGeometry
        const js = 'var sx=' + sg.x + '; var sy=' + sg.y + '; var saved=[];'
            + 'for (const p of panels()) {'
            + ' var g = screenGeometry(p.screen);'
            + ' if (g.x==sx && g.y==sy'
            + '     && (p.hiding=="autohide" || p.hiding=="dodgewindows")) {'
            + '  saved.push(String(p.id)+";"+String(p.screen)+";"+p.location'
            + '    +";"+(p.hiding=="dodgewindows" ? "2" : "1"));'
            + ' }'
            + '}'
            + 'print(JSON.stringify(saved));'
        shellExec.connectSource(shellScriptCommand(js) + opTag("suspendread"))
    }

    // PHASE 2: the backup goes TO DISK before any mutation — write to a
    // temporary file, sync (durability even across a hard system
    // shutdown) and an atomic mv. The backup is created only when the
    // read found panels to suspend, i.e. when the panel state is about to
    // differ from what the user wants to have after a restart.
    function onSuspendRead(ok, stdout) {
        if (panelSuspendState !== "reading") {
            return
        }
        let saved = []
        if (ok) {
            const a = stdout.indexOf("[")
            const b = stdout.lastIndexOf("]")
            if (a !== -1 && b > a) {
                try {
                    saved = JSON.parse(stdout.substring(a, b + 1))
                } catch (e) {}
            }
        }
        if (!ok || saved.length === 0) {
            panelSuspendState = "idle"
            return
        }
        if (!fullscreenDialog.visible) {
            // Menu closed before the reply arrived — mutate nothing.
            panelSuspendState = "idle"
            return
        }
        panelBackup = saved
        panelSuspendState = "persisting"
        const base = 'panel-backup-' + instanceTag + '.json'
        shellExec.connectSource(
            'd=' + backupDirSh + ' && mkdir -p "$d"'
            + " && printf '%s' '" + JSON.stringify(Array.from(saved)) + "'"
            + ' > "$d/' + base + '.tmp"'
            + ' && sync "$d/' + base + '.tmp"'
            + ' && mv -f "$d/' + base + '.tmp" "$d/' + base + '"'
            + opTag("persist"))
    }

    function onPersistDone(ok) {
        if (panelSuspendState !== "persisting") {
            return
        }
        if (!ok) {
            // Without a persisted backup the panels MUST NOT be mutated
            // (better for the panels to hide under the menu than to be
            // left in windowsgobelow after a crash with no trace of the
            // original modes).
            panelBackup = []
            panelSuspendState = "idle"
            return
        }
        if (!fullscreenDialog.visible) {
            // Menu closed during the write — clean up the file, mutate nothing.
            shellExec.connectSource('rm -f ' + backupFileSh + opTag("cleanup"))
            panelBackup = []
            panelSuspendState = "idle"
            return
        }
        // PHASE 3: only now switch the panels to windowsgobelow (in
        // plasmashell's memory only — its lazy write will update the
        // disk; the backup file is already persisted, so every shutdown
        // scenario is reversible).
        panelSuspendState = "applying"
        const js = 'var items=' + JSON.stringify(Array.from(panelBackup)) + ';'
            + 'for (const it of items) {'
            + ' var parts = String(it).split(";");'
            + ' for (const p of panels()) {'
            + '  if (String(p.id)==parts[0]) {'
            + '   p.hiding = "windowsgobelow";'
            + '  }'
            + ' }'
            + '}'
        shellExec.connectSource(shellScriptCommand(js) + opTag("apply"))
    }

    function onApplyDone(ok) {
        if (panelSuspendState !== "applying") {
            return
        }
        panelSuspendState = "active"
        if (!fullscreenDialog.visible) {
            // Menu closed during the switch — restore right away.
            restorePanelHiding()
        }
    }

    // Restore with ON-DISK verification. Three steps in ONE command:
    // (A) evaluateScript sets p.hiding in plasmashell's MEMORY (the live
    //     effect + its future lazy write will persist the same value),
    // (B) kwriteconfig6 writes panelVisibility DIRECTLY to plasmashellrc
    //     (durable immediately — plasmashell only saves its config on a
    //     debounced 10 s timer, which simply does not fire in time during
    //     system shutdown; that is why the in-memory confirmation was
    //     false and the panels came back up from a dirty disk),
    // (C) kreadconfig6 reads the values BACK — the backup disappears ONLY
    //     when the disk shows the user's modes.
    // The match counter in (A) protects against an "empty success" at
    // start, when the panels do not exist yet. The old "stuck" gate
    // (counting p.hiding=="windowsgobelow") was removed: the hiding
    // getter in Plasma 6.7.5 has no case for windowsgobelow and returns
    // "none", so that counter was identically zero (a dead guard).
    function restorePanelHiding() {
        if (panelSuspendState === "reading"
                || panelSuspendState === "persisting"
                || panelSuspendState === "applying") {
            restoreRetryTimer.restart()
            return
        }
        const backup = panelBackup
        if (!backup || backup.length === 0) {
            panelSuspendState = "idle"
            restoreRetryTimer.stop()
            restoreRetryTimer.attempts = 0
            return
        }
        // New entries: "id;screen;location;modeInt"; entries of the older
        // version (migration): "screen;location;modeString" — both handled.
        const js = 'var items=' + JSON.stringify(Array.from(backup)) + ';'
            + 'var matched=0;'
            + 'for (const it of items) {'
            + ' var q = String(it).split(";");'
            + ' for (const p of panels()) {'
            + '  var hit = (q.length>=4)'
            + '    ? String(p.id)==q[0]'
            + '    : (String(p.screen)==q[0] && p.location==q[1]);'
            + '  if (hit) {'
            + '   p.hiding = (q.length>=4)'
            + '     ? (q[3]=="2" ? "dodgewindows" : "autohide")'
            + '     : q[2];'
            + '   matched++;'
            + '  }'
            + ' }'
            + '}'
            + 'print(matched);'
        let cmd = shellScriptCommand(js) + ' && R=""'
        for (const it of backup) {
            const q = String(it).split(";")
            if (q.length < 4) {
                continue
            }
            cmd += ' && kwriteconfig6 --file plasmashellrc --group PlasmaViews'
                + ' --group "Panel ' + q[0] + '" --key panelVisibility ' + q[3]
                + ' && R="$R;$(kreadconfig6 --file plasmashellrc'
                + ' --group PlasmaViews --group "Panel ' + q[0] + '"'
                + ' --key panelVisibility)"'
        }
        cmd += ' && printf "READBACK%s" "$R"'
        shellExec.connectSource(cmd + opTag("restore"))
        restoreRetryTimer.restart()
    }

    function onRestoreDone(ok, stdout) {
        let confirmed = false
        if (ok) {
            // gdbus wraps the print() result in a tuple: ('N\n',).
            const m = stdout.match(/\('([0-9]+)/)
            const matched = m ? parseInt(m[1], 10) : -1
            const idx = stdout.indexOf("READBACK")
            const readback = idx === -1 ? [] : stdout.substring(idx + 8)
                .trim().split(";").filter(s => s.length > 0)
            const expected = []
            for (const it of panelBackup) {
                const q = String(it).split(";")
                if (q.length >= 4) {
                    expected.push(q[3])
                }
            }
            confirmed = matched >= panelBackup.length
                && readback.length === expected.length
                && expected.every((v, i) => readback[i] === v)
        }
        if (confirmed) {
            // The DISK confirmed the user's modes — only now does the
            // backup disappear (the instance file + the older version's
            // migration carriers).
            shellExec.connectSource('rm -f ' + backupFileSh + ' '
                + legacyBackupFileSh + opTag("cleanup"))
            Plasmoid.configuration.panelHidingBackup = []
            panelBackup = []
            panelSuspendState = "idle"
            restoreRetryTimer.stop()
            restoreRetryTimer.attempts = 0
        }
        // Otherwise the backup stays — the repeating retry will try again.
    }

    // Repeated restore retries (with a limit and a watchdog for a lost
    // read/apply reply).
    Timer {
        id: restoreRetryTimer
        interval: 500
        repeat: true
        property int attempts: 0
        onTriggered: {
            if (fullscreenDialog.visible) {
                stop()
                attempts = 0
                return
            }
            if (root.panelBackup.length === 0
                    && panelSuspendState === "idle") {
                stop()
                attempts = 0
                return
            }
            attempts++
            if (attempts > 30) {
                stop()
                attempts = 0
                return
            }
            if ((panelSuspendState === "reading"
                    || panelSuspendState === "persisting"
                    || panelSuspendState === "applying") && attempts >= 6) {
                // The read/persist/apply reply is considered lost.
                panelSuspendState = "active"
            }
            if (panelSuspendState !== "reading"
                    && panelSuspendState !== "persisting"
                    && panelSuspendState !== "applying") {
                restorePanelHiding()
            }
        }
    }

    function setFullscreen(on) {
        if (on) {
            popupDialog.closeMenu()
        } else {
            fullscreenDialog.closeMenu()
        }
        Plasmoid.configuration.fullscreen = on
        activeDialog.openMenu()
    }

    // The panel window hosting the icon — used to compute a floating
    // panel's gap from the screen edge (PopupDialog).
    readonly property var panelWindow:
        fullRepresentationItem ? fullRepresentationItem.panelWindow : null

    fullRepresentation: MouseArea {
        id: iconRoot

        Layout.minimumWidth: -1
        Layout.minimumHeight: -1
        Layout.maximumWidth: Kirigami.Units.iconSizes.huge
        Layout.maximumHeight: Kirigami.Units.iconSizes.huge

        readonly property var panelWindow: Window.window

        hoverEnabled: true
        onClicked: root.activeDialog.toggle()

        Kirigami.Icon {
            anchors.fill: parent
            source: Plasmoid.icon
            active: iconRoot.containsMouse
        }
    }

    FullscreenDialog {
        id: fullscreenDialog
    }

    PopupDialog {
        id: popupDialog
    }

    // The menu's main data source: application categories exactly as used
    // by Kickoff and Kicker (standard XDG categories).
    Kicker.RootModel {
        id: rootModel

        autoPopulate: false
        appNameFormat: 0
        flat: false
        sorted: true
        showSeparators: false
        showTopLevelItems: false
        appletInterface: root

        showAllApps: false
        showAllAppsCategorized: false
        showRecentApps: false
        showRecentDocs: false
        showRecentFolders: false
        showPowerSession: false
        showFavoritesPlaceholder: false
        showRootSeparator: false
        highlightNewlyInstalledApps: false

        // systemFavoritesModel is ready only after refresh(), so the power
        // action list is set on the refreshed signal (idempotently).
        onRefreshed: root.applyPowerActions()
    }

    // "gamemode" is our own entry (PowerMenu), not a kicker action —
    // only the remaining ones go into the system model.
    function applyPowerActions() {
        rootModel.systemFavoritesModel.favorites =
            Array.from(Plasmoid.configuration.powerActions)
                .filter(a => a !== "gamemode")
    }

    Connections {
        target: Plasmoid.configuration
        function onPowerActionsChanged() {
            root.applyPowerActions()
        }
    }

    // Search (KRunner): applications + system settings.
    Kicker.RunnerModel {
        id: runnerModel

        appletInterface: root
        favoritesModel: rootModel.favoritesModel
        runners: ["krunner_services", "krunner_systemsettings"]
        mergeResults: true
    }

    Component.onCompleted: {
        rootModel.favoritesModel.initForClient(
            "org.kde.plasma.elevenmenu.favorites.instance-" + Plasmoid.id)

        if (!Plasmoid.configuration.favoritesSeeded) {
            rootModel.favoritesModel.favorites = Plasmoid.configuration.favorites
            Plasmoid.configuration.favoritesSeeded = true
        }

        rootModel.refresh()

        // Game Mode detection (once, at menu startup).
        shellExec.connectSource(
            "test -x /usr/bin/return-to-gamemode && echo GMYES"
            + opTag("gamemodecheck"))

        // Self-repair at EVERY plasmashell start: if a mode backup file
        // lies on disk (restore did not make it, or its write was lost
        // at system shutdown), load it — the file disappears only after
        // the on-disk confirmation in onRestoreDone. The file of THIS
        // instance is read and, for migration, the shared file of the
        // older applet version.
        shellExec.connectSource('cat ' + backupFileSh
            + ' 2>/dev/null; printf "@@SEP@@"; cat ' + legacyBackupFileSh
            + ' 2>/dev/null; true' + opTag("bootread"))
    }

    function parseBackupArray(text) {
        const a = text.indexOf("[")
        const b = text.lastIndexOf("]")
        if (a === -1 || b <= a) {
            return []
        }
        try {
            const parsed = JSON.parse(text.substring(a, b + 1))
            return Array.isArray(parsed) ? parsed : []
        } catch (e) {
            return []
        }
    }

    function onBootRead(ok, stdout) {
        const parts = (stdout ?? "").split("@@SEP@@")
        let saved = parseBackupArray(parts[0] ?? "")
            .concat(parseBackupArray(parts[1] ?? ""))
        if (saved.length === 0) {
            // Migration: the oldest applet version kept the backup in the config.
            saved = Array.from(Plasmoid.configuration.panelHidingBackup ?? [])
        }
        if (saved.length === 0 || panelSuspendState !== "idle") {
            return
        }
        panelBackup = saved
        panelSuspendState = "active"
        restorePanelHiding()
    }
}
